APP_NAME=BULA-IA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

BULAI_ADMIN_NAME="BULA-IA Admin"
BULAI_ADMIN_EMAIL=
BULAI_ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bulai
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
KNOWLEDGE_FILESYSTEM_DISK=knowledge
KNOWLEDGE_INGESTION_MAX_FILES=15
KNOWLEDGE_INGESTION_MAX_FILE_KILOBYTES=20480
QUEUE_CONNECTION=database
KNOWLEDGE_MAX_PDF_BYTES=26214400
KNOWLEDGE_MAX_PAGES=500
KNOWLEDGE_MAX_TEXT_CHARACTERS=5000000
KNOWLEDGE_MIN_TEXT_CHARACTERS=20
KNOWLEDGE_JOB_TIMEOUT_SECONDS=60
KNOWLEDGE_IDENTIFICATION_FIRST_PAGES=2
KNOWLEDGE_IDENTIFICATION_LAST_PAGES=4
KNOWLEDGE_CHUNK_TARGET_CHARACTERS=1800
KNOWLEDGE_CHUNK_MAX_CHARACTERS=2600
KNOWLEDGE_CHUNK_OVERLAP_CHARACTERS=200

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
