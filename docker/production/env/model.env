# Modelo da IA local (classificador auxiliar da ingestão). Valores NÃO secretos; instalados no diretório de
# confiança pelo instalador. O arquivo .gguf fica em /srv/bulai/shared/models (fora do Git e das releases) e é validado
# por SHA-256 pelo script scripts/install-local-model.sh. Para trocar de modelo: atualizar este arquivo via PR,
# reinstalar o conjunto confiável e executar `bulai-deploy ensure-model`.
LOCAL_AI_MODEL_NAME=qwen2.5-1.5b-instruct
LOCAL_AI_MODEL_FILENAME=qwen2.5-1.5b-instruct-q4_k_m.gguf
LOCAL_AI_MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF/resolve/main/qwen2.5-1.5b-instruct-q4_k_m.gguf
LOCAL_AI_MODEL_SHA256=6a1a2eb6d15622bf3c96857206351ba97e1af16c30d7a74ee38970e434e9407e
LOCAL_AI_MODEL_QUANTIZATION=Q4_K_M

# Modelo de EMBEDDINGS do RAG vetorial/híbrido (serviço `embeddings`, mesma imagem do local-ai em modo embedding).
# Instalado no mesmo diretório pelo script scripts/install-embedding-model.sh (também via `bulai-deploy ensure-model`).
EMBEDDINGS_MODEL_NAME=bge-m3
EMBEDDINGS_MODEL_FILENAME=bge-m3-Q8_0.gguf
EMBEDDINGS_MODEL_URL=https://huggingface.co/gpustack/bge-m3-GGUF/resolve/main/bge-m3-Q8_0.gguf
EMBEDDINGS_MODEL_SHA256=950f4a8e5e19477a6d3c26d2f162233c20002c601f75e4b002e3239997821167
EMBEDDINGS_MODEL_QUANTIZATION=Q8_0
