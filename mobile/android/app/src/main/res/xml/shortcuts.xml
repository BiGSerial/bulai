<?xml version="1.0" encoding="utf-8"?>
<!-- Atalhos do ícone (toque longo). Interações entra quando a tela nativa existir. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:icon="@drawable/ic_atalho_hoje"
        android:shortcutId="hoje"
        android:shortcutLongLabel="@string/atalho_hoje"
        android:shortcutShortLabel="@string/atalho_hoje_curto">
        <intent android:action="android.intent.action.VIEW" android:data="bulai://abrir/hoje" />
    </shortcut>
    <shortcut
        android:icon="@drawable/ic_atalho_perguntar"
        android:shortcutId="perguntar"
        android:shortcutLongLabel="@string/atalho_perguntar"
        android:shortcutShortLabel="@string/atalho_perguntar_curto">
        <intent android:action="android.intent.action.VIEW" android:data="bulai://abrir/perguntar" />
    </shortcut>
    <shortcut
        android:icon="@drawable/ic_atalho_receita"
        android:shortcutId="receita"
        android:shortcutLongLabel="@string/atalho_receita"
        android:shortcutShortLabel="@string/atalho_receita_curto">
        <intent android:action="android.intent.action.VIEW" android:data="bulai://abrir/receitas/nova" />
    </shortcut>
</shortcuts>
