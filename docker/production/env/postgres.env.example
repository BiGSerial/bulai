# Ambiente do PostgreSQL — /srv/bulai/shared/env/postgres.env (root:root, 0600). Só o serviço `postgres` lê este arquivo.
POSTGRES_USER=bulai_admin         # superusuário de manutenção (backup, extensão pgvector); NÃO é usado pela aplicação
POSTGRES_PASSWORD=                # senha do superusuário
BULAI_DB_PASSWORD=                # senha do papel `bulai` (dono do banco, sem superusuário); mínimo 24 caracteres; igual a DB_PASSWORD em app.env
# Observação: estas variáveis só têm efeito na PRIMEIRA inicialização do volume. Trocar a senha depois exige
# ALTER ROLE no banco (veja docs/deployment/kinghost.md, "Rotação de segredos").
