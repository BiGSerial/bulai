# Arquivo de ambiente da APLICAÇÃO (app e worker) — copiado para /srv/bulai/shared/env/app.env (root:root, 0600).
# `sudo bulai-deploy init-secrets` cria este arquivo com segredos aleatórios; este exemplo documenta cada variável.
# NUNCA versione o arquivo real. Valores abaixo são apenas ilustrativos.

APP_NAME=BULA-IA
APP_KEY=                         # base64:… (php artisan key:generate --show); trocar invalida sessões e dados cifrados
APP_URL=https://bulai.vixforge.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
LOG_LEVEL=info

# Banco: DB_HOST/PORT são fixos no compose (serviço `postgres`). A senha deve ser IGUAL a BULAI_DB_PASSWORD de postgres.env.
DB_DATABASE=bulai
DB_USERNAME=bulai
DB_PASSWORD=

# Fila (jobs de OCR/IA demoram): DB_QUEUE_RETRY_AFTER deve ser MAIOR que o timeout do worker (450 s) — padrão 900.
DB_QUEUE_RETRY_AFTER=900
KNOWLEDGE_JOB_TIMEOUT_SECONDS=420

# OCR/IA (URLs fixas no compose). O token deve ser IGUAL a OCR_API_TOKEN de ocr.env.
DOCUMENT_OCR_TOKEN=
DOCUMENT_OCR_TIMEOUT=300
LOCAL_AI_TIMEOUT=90
LOCAL_AI_MODEL_NAME=qwen2.5-1.5b-instruct

# IA principal do RAG (explicações, perguntas e bula humanizada): Anthropic Messages API. app/worker precisam de saída
# para a internet (rede `egress` do compose). Orçamentos em USD/tokens evitam surpresas; ver docs/ai/anthropic-provider.md.
AI_TEXT_DRIVER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=2048
ANTHROPIC_TIMEOUT=90
ANTHROPIC_DAILY_USD_BUDGET=5
ANTHROPIC_MONTHLY_USD_BUDGET=50

# Embeddings do RAG vetorial/híbrido: serviço `embeddings` (URL fixa no compose: http://embeddings:8080/v1).
# O nome do modelo deve ser IGUAL a EMBEDDINGS_MODEL_NAME de model.env. Após o deploy: `bulai-deploy artisan knowledge:index-embeddings`.
AI_EMBEDDING_DRIVER=openai_compatible
AI_EMBEDDING_MODEL=bge-m3
AI_EMBEDDING_TIMEOUT=120
# lexical | vector | hybrid (vector/hybrid só depois de indexar os chunks).
BULAI_RETRIEVAL_MODE=hybrid

# Retenção (dias) de consultas e perguntas gravadas; purga diária pelo scheduler (`schedule:run`).
BULAI_CONSULTATION_RETENTION_DAYS=90
BULAI_QUESTIONS_RETENTION_DAYS=90
# Bula humanizada.
BULAI_LEAFLET_MAX_OUTPUT_TOKENS=1400
BULAI_LEAFLET_EVIDENCE_PER_SECTION=3

# Programação do tratamento e lembretes (serviço `scheduler` do compose roda `treatment:send-reminders` a cada 5 min).
# Fuso padrão dos horários de dose (o paciente pode escolher outro em Avisos); janela do lembrete antes do horário;
# minutos até a dose contar como atrasada. O lembrete por e-mail (opcional por paciente) exige MAIL_MAILER configurado.
BULAI_TREATMENT_TIMEZONE=America/Sao_Paulo
BULAI_REMINDER_LEAD_MINUTES=10
BULAI_DOSE_LATE_AFTER_MINUTES=60
BULAI_REMINDER_QUEUE=default

# Cookies/sessão por HTTPS (o Nginx informa HTTPS ao PHP a partir do Caddy).
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true

# Administrador inicial (usado por `php artisan db:seed` no primeiro deploy; veja a documentação).
BULAI_ADMIN_NAME=Administrador
BULAI_ADMIN_EMAIL=
BULAI_ADMIN_PASSWORD=

# Opcional, só se o Nginx NÃO resolver IP/HTTPS (topologia diferente): proxies confiáveis do Laravel (CIDRs ou *).
# TRUSTED_PROXIES=

# Hash de senhas (argon2id, RFC 9106). Senhas bcrypt antigas migram no próximo login.
HASH_DRIVER=argon2id
# HASH_ARGON_MEMORY=65536
# HASH_ARGON_THREADS=1
# HASH_ARGON_TIME=4

# Redefinição de senha por e-mail ("Esqueci minha senha"): sem MAIL_* válido o link nunca chega.
# Recomendado: API do SMTP Transacional da KingHost (o domínio do remetente precisa estar cadastrado e com DNS validado).
# MAIL_MAILER=kinghost
# KINGHOST_SMTP_TOKEN=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME="BULA-IA"
# Alternativa: SMTP genérico (MAIL_MAILER=smtp, MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD).
