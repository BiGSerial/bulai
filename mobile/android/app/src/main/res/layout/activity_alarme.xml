<?xml version="1.0" encoding="utf-8"?>
<!-- Alarme em tela cheia: letras grandes e botões altos (público idoso, mãos trêmulas). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarme_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/alarme_horario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/branco"
        android:textSize="64sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/alarme_hora_do_remedio"
        android:textColor="@color/branco"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/alarme_nome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textColor="@color/branco"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/alarme_dose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/branco"
        android:textSize="24sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/alarme_tomei"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/fundo_botao_claro"
        android:text="@string/acao_tomei"
        android:textAllCaps="false"
        android:textColor="@color/marca"
        android:textSize="26sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/alarme_adiar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/fundo_botao_contorno"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="22sp" />

    <Button
        android:id="@+id/alarme_pular"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:text="@string/acao_pular"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="20sp" />
</LinearLayout>
