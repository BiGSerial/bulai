# Valores padrão do serviço local-ai (sobrescritos pelo ambiente do compose).
LOCAL_AI_THREADS=4
LOCAL_AI_CONTEXT=8192
LOCAL_AI_LOAD_TIMEOUT=600
LOCAL_AI_REQUEST_TIMEOUT=120
LOCAL_AI_MODEL_FILENAME=model.gguf
# chat (classificador da ingestão) ou embedding (llamafiler --v2 servindo /v1/embeddings para o RAG vetorial).
LOCAL_AI_MODE=chat
