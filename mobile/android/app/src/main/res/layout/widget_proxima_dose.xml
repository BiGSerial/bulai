<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_widget"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_titulo"
            android:textColor="@color/texto_suave"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_nome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/marca"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_horario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texto"
            android:textSize="16sp" />
    </LinearLayout>

    <Button
        android:id="@+id/widget_tomei"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/fundo_widget_botao"
        android:minWidth="96dp"
        android:paddingHorizontal="16dp"
        android:text="@string/acao_tomei"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
