APP_NAME=BULA-IA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

BULAI_ADMIN_NAME="BULA-IA Admin"
BULAI_ADMIN_EMAIL=
BULAI_ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bulai
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
KNOWLEDGE_FILESYSTEM_DISK=knowledge
KNOWLEDGE_INGESTION_MAX_BATCH_KILOBYTES=102400
KNOWLEDGE_INGESTION_MAX_FILE_KILOBYTES=102400
KNOWLEDGE_PROGRESS_STALE_MINUTES=5
QUEUE_CONNECTION=database
KNOWLEDGE_MAX_PDF_BYTES=26214400
KNOWLEDGE_MAX_PAGES=500
KNOWLEDGE_MAX_TEXT_CHARACTERS=5000000
KNOWLEDGE_MIN_TEXT_CHARACTERS=20
KNOWLEDGE_JOB_TIMEOUT_SECONDS=60
# Com OCR habilitado: KNOWLEDGE_JOB_TIMEOUT_SECONDS=330, DB_QUEUE_RETRY_AFTER=400 e queue:work --timeout=330
KNOWLEDGE_IDENTIFICATION_FIRST_PAGES=2
KNOWLEDGE_IDENTIFICATION_LAST_PAGES=4
KNOWLEDGE_CHUNK_TARGET_CHARACTERS=1800
KNOWLEDGE_CHUNK_MAX_CHARACTERS=2600
KNOWLEDGE_CHUNK_OVERLAP_CHARACTERS=200

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

DOCUMENT_OCR_ENABLED=true
DOCUMENT_OCR_DRIVER=http
DOCUMENT_OCR_URL=http://127.0.0.1:8090
DOCUMENT_OCR_TOKEN=
DOCUMENT_OCR_TIMEOUT=300
DOCUMENT_OCR_CONNECT_TIMEOUT=5
DOCUMENT_OCR_RETRIES=1

# Providers de IA (vazio = capacidade desabilitada). Drivers: openai_compatible
AI_TEXT_DRIVER=
AI_TEXT_BASE_URL=
AI_TEXT_API_KEY=
AI_TEXT_MODEL=
AI_EMBEDDING_DRIVER=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_VISION_DRIVER=
AI_VISION_BASE_URL=
AI_VISION_API_KEY=
AI_VISION_MODEL=

# Classificador local (llamafile) — resolve ambiguidades da ingestão; NÃO é a IA principal do app.
DOCUMENT_CLASSIFIER_DRIVER=llamafile
LOCAL_AI_URL=http://127.0.0.1:8088
LOCAL_AI_HOST_PORT=8088
LOCAL_AI_TIMEOUT=90
LOCAL_AI_MODEL_NAME=qwen2.5-1.5b-instruct
LOCAL_AI_MODEL_FILENAME=qwen2.5-1.5b-instruct-q4_k_m.gguf
LOCAL_AI_MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF/resolve/main/qwen2.5-1.5b-instruct-q4_k_m.gguf
LOCAL_AI_MODEL_SHA256=6a1a2eb6d15622bf3c96857206351ba97e1af16c30d7a74ee38970e434e9407e
LOCAL_AI_MODEL_PATH=/models
LOCAL_AI_THREADS=4
LOCAL_AI_CONTEXT=2048
DOCUMENT_CLASSIFICATION_AUTO_ACCEPT_SCORE=85
DOCUMENT_CLASSIFICATION_AI_MIN_SCORE=40
DOCUMENT_CLASSIFICATION_AI_MIN_CONFIDENCE=0.85
DOCUMENT_CLASSIFICATION_STORE_PROMPT=true
DOCUMENT_CLASSIFICATION_DISPATCH_ON_INGEST=true
